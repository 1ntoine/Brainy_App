# Copier vers .env puis adapter

# Ports des services
GATEWAY_PORT=4000
TASKS_PORT=4001
CALENDAR_PORT=4002
NOTIFICATIONS_PORT=4003
ROUTINE_PORT=4004

# Heure de la routine du matin (HH:mm)
ROUTINE_TIME=07:00

# Ville pour la météo (Open-Meteo, sans clé d'API)
WEATHER_CITY=Nantes

# Boîte mail (IMAP) — optionnel, la routine fonctionne sans
# Gmail : imap.gmail.com, port 993, mot de passe d'application
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_TLS=true
IMAP_FOLDER=INBOX

# OAuth2 Microsoft (requis pour les boîtes Outlook / Microsoft 365)
AZURE_CLIENT_ID=
# consumers = comptes personnels, common = perso + pro, ou votre tenant
AZURE_TENANT_ID=common
# Jeton brut alternatif (non recommandé, expire en ~1 h)
IMAP_ACCESS_TOKEN=
